{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncf.primary-selected-immutable-source-manifest.v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "selected_source", "source_artifacts", "inventory_sha256",
    "immutable", "inventory_complete"
  ],
  "properties": {
    "schema_version": {"const": "NCF-PRIMARY-SELECTED-IMMUTABLE-SOURCE-MANIFEST-1.0.0"},
    "selected_source": {"$ref": "#/$defs/contentRef"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/sourceArtifact"}
    },
    "inventory_sha256": {"$ref": "#/$defs/sha256"},
    "immutable": {"const": true},
    "inventory_complete": {"const": true}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "sourceArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes", "source_role"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1},
        "source_role": {
          "enum": ["PRIMARY_ARTICLE", "SUPPLEMENT", "FIGURE", "TABLE", "OTHER_SELECTED_SOURCE_ASSET"]
        }
      }
    }
  }
}
