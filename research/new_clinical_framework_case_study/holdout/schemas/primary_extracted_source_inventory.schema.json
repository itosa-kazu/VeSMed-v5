{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncf.primary-extracted-source-inventory.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "selected_source_manifest", "source_artifacts", "inventory_sha256"],
  "properties": {
    "schema_version": {"const": "NCF-PRIMARY-EXTRACTED-SOURCE-INVENTORY-1.0.0"},
    "selected_source_manifest": {"$ref": "#/$defs/contentRef"},
    "source_artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/contentRef"}
    },
    "inventory_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|/)\\.\\.(?:/|$)).+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
