{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncf.primary-gate-evidence-bundle.v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "contract_id", "contract_version", "correct_diagnosis_reported", "gate_results"],
  "properties": {
    "schema_version": {"const": "ncf.primary-gate-evidence-bundle.v1"},
    "contract_id": {"const": "NCF-PERFECT-LANDING-GATES"},
    "contract_version": {"const": "1.1.0"},
    "correct_diagnosis_reported": {"type": "boolean"},
    "gate_results": {
      "type": "array",
      "minItems": 29,
      "maxItems": 30,
      "items": {"$ref": "#/$defs/resultRow"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "bytes"],
      "properties": {
        "path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "bytes": {"type": "integer", "minimum": 1}
      }
    },
    "resultRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gate_id", "result", "evidence_refs"],
      "properties": {
        "gate_id": {"type": "string", "pattern": "^PL-[A-Z]+-[0-9]{3}$"},
        "result": {"enum": ["PASS", "FAIL"]},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 1, "items": {"$ref": "#/$defs/contentRef"}}
      }
    }
  }
}
