{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncf.primary-perfect-landing-report-candidate.v1",
  "title": "NCF two-stage perfect-landing report candidate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "contract_binding",
    "source_bundle_refs",
    "gate_results",
    "complex_coverage",
    "facet_results",
    "candidate_verdict",
    "permitted_candidate_verdicts",
    "permitted_final_verdicts",
    "scope_and_limits",
    "diagnosis_override_permitted",
    "terminal_outcome_override_permitted"
  ],
  "properties": {
    "schema_version": {
      "const": "ncf.primary-perfect-landing-report-candidate.v1"
    },
    "contract_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_contract_id",
        "gate_contract_version",
        "scoring_contract_id",
        "scoring_contract_version"
      ],
      "properties": {
        "gate_contract_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "gate_contract_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoring_contract_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "scoring_contract_version": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "source_bundle_refs": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nonreport_gate_bundle",
        "complex_coverage_bundle"
      ],
      "properties": {
        "nonreport_gate_bundle": {
          "$ref": "#/$defs/contentRef"
        },
        "complex_coverage_bundle": {
          "$ref": "#/$defs/contentRef"
        }
      }
    },
    "gate_results": {
      "type": "array",
      "minItems": 30,
      "maxItems": 30,
      "items": {
        "$ref": "#/$defs/gateRow"
      }
    },
    "complex_coverage": {
      "type": "array",
      "minItems": 7,
      "maxItems": 7,
      "items": {
        "$ref": "#/$defs/coverageRow"
      }
    },
    "facet_results": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/facetRow"
      }
    },
    "candidate_verdict": {
      "enum": [
        "FAILED",
        "PENDING_REPORT_CONSISTENCY"
      ]
    },
    "permitted_candidate_verdicts": {
      "const": [
        "FAILED",
        "PENDING_REPORT_CONSISTENCY"
      ]
    },
    "permitted_final_verdicts": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "scope_and_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "frozen_scope",
        "one_case_only",
        "runtime_probabilities_clinically_calibrated",
        "probability_interpretation",
        "population_probability_claims_forbidden",
        "unperformed_individual_effect_identified_by_observed_response",
        "counterfactual_status_vocabulary",
        "ood_requires_residual_or_partial_answer",
        "ood_rule",
        "forbidden_claims"
      ],
      "properties": {
        "frozen_scope": {
          "type": "string",
          "minLength": 1
        },
        "one_case_only": {
          "const": true
        },
        "runtime_probabilities_clinically_calibrated": {
          "const": false
        },
        "probability_interpretation": {
          "type": "string",
          "minLength": 1
        },
        "population_probability_claims_forbidden": {
          "const": true
        },
        "unperformed_individual_effect_identified_by_observed_response": {
          "const": false
        },
        "counterfactual_status_vocabulary": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "ood_requires_residual_or_partial_answer": {
          "const": true
        },
        "ood_rule": {
          "type": "string",
          "minLength": 1
        },
        "forbidden_claims": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "diagnosis_override_permitted": {
      "const": false
    },
    "terminal_outcome_override_permitted": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "contentRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "sha256",
        "bytes"
      ],
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "$ref": "#/$defs/sha256"
        },
        "bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "evidenceRefs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/contentRef"
      }
    },
    "gateRow": {
      "type": "object",
      "required": [
        "gate_id",
        "result"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING_REPORT_CONSISTENCY"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        },
        "derivation": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "result": {
                "enum": [
                  "PASS",
                  "FAIL"
                ]
              }
            }
          },
          "then": {
            "required": [
              "evidence_refs"
            ]
          }
        },
        {
          "if": {
            "properties": {
              "result": {
                "const": "PENDING_REPORT_CONSISTENCY"
              }
            }
          },
          "then": {
            "required": [
              "derivation"
            ]
          }
        }
      ],
      "additionalProperties": true
    },
    "coverageRow": {
      "type": "object",
      "required": [
        "coverage_id",
        "result",
        "evidence_refs"
      ],
      "properties": {
        "coverage_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/evidenceRefs"
        }
      },
      "additionalProperties": true
    },
    "facetGateRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "result"
      ],
      "properties": {
        "gate_id": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING_REPORT_CONSISTENCY"
          ]
        }
      }
    },
    "facetRow": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "facet_id",
        "pass_state",
        "result",
        "gate_results"
      ],
      "properties": {
        "facet_id": {
          "type": "string",
          "minLength": 1
        },
        "pass_state": {
          "type": "string",
          "minLength": 1
        },
        "result": {
          "enum": [
            "PASS",
            "FAIL",
            "PENDING_REPORT_CONSISTENCY"
          ]
        },
        "gate_results": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/facetGateRow"
          }
        }
      }
    }
  }
}
