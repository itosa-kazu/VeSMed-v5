{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ncf.structural-gate-evidence.v1",
  "title": "Case-blind structural gate evidence",
  "type": "object",
  "required": [
    "schema_version",
    "artifact_id",
    "produced_by",
    "generated_at",
    "status",
    "gate_ids",
    "architecture_gates",
    "case_blind",
    "summary",
    "assertions",
    "inputs",
    "metrics",
    "outputs",
    "limitations",
    "errors"
  ],
  "properties": {
    "schema_version": {"const": "ncf.structural-gate-evidence.v1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "produced_by": {"const": "holdout/tools/structural_gate_harness.py"},
    "generated_at": {"type": "string", "format": "date-time"},
    "status": {
      "enum": ["PASS", "FAIL", "NOT_APPLICABLE", "NOT_EXECUTED", "EVIDENCE_MISSING"]
    },
    "gate_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^PL-"}
    },
    "architecture_gates": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^G(0[1-9]|1[0-7])$"}
    },
    "case_blind": {"const": true},
    "summary": {"type": "string", "minLength": 1},
    "assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assertion_id", "passed", "expected", "observed"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "passed": {"type": ["boolean", "null"]},
          "expected": {},
          "observed": {},
          "notes": {"type": "string"}
        },
        "additionalProperties": true
      }
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["path", "sha256", "role"],
        "properties": {
          "path": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "role": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "metrics": {"type": "object"},
    "outputs": {"type": "object"},
    "limitations": {"type": "array", "items": {"type": "string"}},
    "errors": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
