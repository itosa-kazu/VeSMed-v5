          "POSSIBLE",
          "PRESENT",
          "UNKNOWN"
        ],
        "conditioned_factor_available": "boolean",
        "disposition": [
          "CONSUME_UNMASKED",
          "CONSUME_CONDITIONED",
          "WITHHOLD_TO_MEASUREMENT_UNCERTAINTY"
        ]
      },
      "alternative_representation": {
        "group_id": "string_or_null",
        "selected_source_result_ids": "array",
        "suppressed_source_result_ids": "array"
      }
    },
    "hard_rules": [
      "FAILED or UNKNOWN method requirement cannot enter factor_messages",
      "FAILED unit normalization cannot enter factor_messages",
      "LOW or UNKNOWN reliability cannot enter factor_messages in the primary verdict",
      "support-masked observation without conditioned factor cannot enter factor_messages",
      "every withheld source_result_id enters unexplained_observations with reason unknown_measurement_condition and contributes to or explicitly explains measurement_uncertainty",
      "reliable negative is rankable only when explicit_assertion, target_scope, adequate_method, adequate_timing and reliability are all true",
      "only selected alternative representation may enter factor_messages"
    ],
    "required_execution_evidence": [
      "mapped_observation_contract_by_event.json",
      "consumed_withheld_residualized_event_ids.json",
      "reliability_modulation_probe_by_event.json",
