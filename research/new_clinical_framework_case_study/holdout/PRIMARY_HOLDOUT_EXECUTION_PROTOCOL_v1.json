        "target_scope",
        "adequate_method",
        "adequate_timing"
      ],
      "rankability_disposition": [
        "CONSUME",
        "WITHHOLD_TO_MEASUREMENT_UNCERTAINTY",
        "RECORD_ONLY"
      ],
      "support_masking_assessment": {
        "active_action_ids_at_sample": "array",
        "masking_risk": [
