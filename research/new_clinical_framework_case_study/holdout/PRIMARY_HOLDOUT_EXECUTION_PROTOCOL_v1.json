      ],
      "required_provenance_fields_present": "array",
      "required_provenance_fields_missing": "array",
      "unit_normalization_status": [
        "SATISFIED",
        "FAILED",
        "NOT_APPLICABLE"
      ],
      "reliability_status": [
        "RELIABLE",
        "LOW",
        "UNKNOWN"
      ],
      "reliability_basis_required": [
