# Bridge evidence hashes are defined over exact checked-in bytes. Disable EOL
# conversion so Windows and POSIX checkouts reproduce the same SHA-256 values.
# cr-at-eol keeps intentional frozen CRLF bytes from becoming whitespace errors.
[attr]bridge-evidence -text whitespace=cr-at-eol
prototype/bridge_holdout/** bridge-evidence
prototype/bridge_mutation_gate.py bridge-evidence
prototype/reference_models.py bridge-evidence
research_notes/bridge_mutation_gate_v1.json bridge-evidence
research_notes/bridge_panel_protocol_v1.json bridge-evidence
tests/bridge_holdout/** bridge-evidence
tests/test_bridge_holdout_fixture.py bridge-evidence
tests/test_bridge_holdout_runs.py bridge-evidence
tests/test_bridge_mutation_gate.py bridge-evidence
tests/test_bridge_public_panels.py bridge-evidence
results/bridge-holdout/** bridge-evidence

# UCM upper-bound reports bind exact canonical JSON and adapter source bytes.
# Keep those bytes platform-invariant so a Windows clean checkout can replay
# the same content-addressed suite roots as POSIX.
[attr]ucm-upper-bound-evidence -text whitespace=cr-at-eol
prototype/unified_map/upper_bound_evaluator*.py ucm-upper-bound-evidence
prototype/unified_map/worlds/*.py ucm-upper-bound-evidence
results/unified_map/pre_freeze/20260717-*/vertical-slice.json ucm-upper-bound-evidence
results/unified_map/pre_freeze/20260718-eight-world-upper-bound-suite/** ucm-upper-bound-evidence
results/unified_map/pre_freeze/20260718-twenty-world-upper-bound-suite/** ucm-upper-bound-evidence

# Raw UCM transport sidecars are binary.  Their decompressed bytes are bound by
# each run's existing canonical manifest.
# All UCM evidence is content-addressed over the exact checked-in bytes.  Do not
# let core.autocrlf rewrite frozen sources, manifests, tests, or reports in a
# Windows clean checkout.  Some frozen v1 files intentionally contain CRLF.
[attr]ucm-evidence -text whitespace=cr-at-eol
prototype/unified_map/** ucm-evidence
research/unified_map/** ucm-evidence
results/unified_map/** ucm-evidence
tests/unified_map/** ucm-evidence
results/unified_map/**/raw-*.jsonl.gz -text -diff

# Generated UCM benchmark evidence is reviewed through its canonical manifests
# and deterministic verifiers, not as a line-oriented source diff.  Limit this
# performance hint to the isolated UCM track: broad `results/**` attributes
# would change Git's filtered-blob identity for the frozen K0 result tree.
results/unified_map/** -text -diff
