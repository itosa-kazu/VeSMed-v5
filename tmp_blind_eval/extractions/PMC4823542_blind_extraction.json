      {
        "item_type": "final_diagnosis",
        "text": "Stage 3 acute kidney injury with severe metabolic derangement precipitated by bilateral ureteric obstruction, with pseudo-obstruction.",
        "source_section": "Investigations",
        "use_in_ranking": false
      },
      {
        "item_type": "treatment",
        "text": "Central line, urinary catheter, fluid resuscitation, intravenous antibiotics, bilateral ultrasound-guided nephrostomies, ICU care, hemofiltration, and later bilateral antegrade ureteric stenting.",
        "source_section": "Treatment",
        "use_in_ranking": false
      },
      {
        "item_type": "response_followup",
        "text": "Nephrostomies were removed after urine output improved and creatinine returned to baseline; staged ureteroscopy and laser fragmentation were planned.",
        "source_section": "Outcome and follow-up",
        "use_in_ranking": false
      }
