      "type": "paper_framing_not_rankable",
      "day": null,
      "text": "The paper frames the case as intentional acetaminophen overdose with acute liver injury and markedly elevated procalcitonin."
    },
    {
      "type": "treatment_choice",
      "day": 0,
      "text": "Oral N-acetylcysteine was started for acetaminophen exposure."
    },
    {
      "type": "treatment_choice",
      "day": 0,
      "text": "Piperacillin/tazobactam was started empirically after two sets of blood cultures were collected."
    },
    {
      "type": "late_course",
      "day": 3,
      "text": "Gastrointestinal symptoms resolved and the patient remained clinically stable without fever."
    },
    {
      "type": "late_lab_trend",
      "day": 3,
      "text": "Procalcitonin rose to 31.29 ng/mL, CRP was 0.93 mg/dL, and WBC count was decreasing."
    },
    {
      "type": "treatment_response",
      "day": 3,
      "text": "Piperacillin/tazobactam was discontinued when underlying sepsis was considered unlikely."
    },
