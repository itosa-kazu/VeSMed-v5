  "actual_treatment": [
    "intravenous fluids with close hemodynamic monitoring for dengue shock syndrome",
    "hemodialysis through a right femoral venous catheter for acute kidney injury",
    "vancomycin followed by linezolid 600 mg every 12 hours for MRSA infective endocarditis, total 4 weeks",
    "enoxaparin 60 mg twice daily and warfarin for proximal femoral deep vein thrombosis; warfarin continued for 3 months"
  ],
  "outcome": {
    "vital_status": "survived",
    "source_text_value": "renal function, liver function, and platelets improved gradually; she responded well to linezolid and completed prolonged treatment for endocarditis and DVT"
  },
